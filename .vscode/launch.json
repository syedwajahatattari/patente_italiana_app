{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Patente App (with OPENROUTER_API_KEY)",
      "request": "launch",
      "type": "dart",
      "args": [
        "--dart-define=OPENROUTER_API_KEY=${env:OPENROUTER_API_KEY}"
      ]
    },
    {
      "name": "Patente App (Release with AI & RevenueCat)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "args": [
        "--dart-define=OPENROUTER_API_KEY=${env:OPENROUTER_API_KEY}",
        "--dart-define=REVENUECAT_GOOGLE_KEY=${env:REVENUECAT_GOOGLE_KEY}"
      ]
    },
    {
      "name": "Patente App (Offline / Safe Mode)",
      "request": "launch",
      "type": "dart"
    }
  ]
}
